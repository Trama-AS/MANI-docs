@startuml ModeloDatos
' Modelo de datos de MANI — generado desde el catálogo de la base tras aplicar las migraciones. Solo PK y FK.
hide circle
skinparam linetype ortho
skinparam shadowing false
skinparam dpi 120
skinparam defaultFontName Helvetica
skinparam classBackgroundColor #FFFFFF
skinparam classBorderColor #3D85C6
title MANI — Modelo de datos (esquema public)
package "Identidad y acceso" #E8EEF7 {
  entity tenant {
    *id : uuid <<PK>>
    --
  }
  entity usuario {
    *id : uuid <<PK>>
    --
    tenant_id : uuid <<FK>>
  }
  entity aliado {
    *id : uuid <<PK>>
    --
    tenant_id : uuid <<FK>>
    usuario_id : uuid <<FK>>
    verificado_por : uuid <<FK>>
  }
  entity documento_kyc {
    *id : uuid <<PK>>
    --
    tenant_id : uuid <<FK>>
    aliado_id : uuid <<FK>>
  }
  entity cliente {
    *id : uuid <<PK>>
    --
    tenant_id : uuid <<FK>>
    usuario_id : uuid <<FK>>
  }
  entity sitio {
    *id : uuid <<PK>>
    --
    tenant_id : uuid <<FK>>
    cliente_id : uuid <<FK>>
    zona_id : uuid <<FK>>
  }
  entity documento_legal {
    *id : uuid <<PK>>
    --
    tenant_id : uuid <<FK>>
  }
  entity consentimiento_usuario {
    *id : uuid <<PK>>
    --
    tenant_id : uuid <<FK>>
    usuario_id : uuid <<FK>>
    documento_legal_id : uuid <<FK>>
  }
  entity tenant_estado_cambio {
    *id : uuid <<PK>>
    --
    tenant_id : uuid <<FK>>
  }
}
