@startuml aceptacion-concurrente
' C4 Nivel 4 (Code) — MANI · Dispatch Service
' Escrito a mano desde el código de MANI-.NET (rama develop). Decisión 6A: Dispatch decide, Core escribe.

title C4 Nivel 4 — Código: aceptación de una solicitud en Dispatch Service (.NET)

skinparam dpi 160
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam class {
  BackgroundColor #EAF1FB
  BorderColor #3D85C6
  ArrowColor #44546A
}

package "Controllers" {
  class DispatchController {
    - AcceptDispatchOfferUseCase _acceptDispatchOfferUseCase
    - RejectDispatchOfferUseCase _rejectDispatchOfferUseCase
    + OrchestrateDispatch(OrchestrateRequestDto) : IActionResult
  }
}

package "Application.UseCases" {
  class AcceptDispatchOfferUseCase {
    - ISolicitudAssignmentRepository _assignmentRepository
    - IAllyRepository _allyRepository
    - ICoreAssignmentClient _coreAssignmentClient
    + ExecuteAsync(requestId, tenantId, usuarioId, idempotencyKey, correlationId) : Task<AssignmentResult>
  }
}

package "Application.Interfaces" {
  interface ISolicitudAssignmentRepository {
    + RejectRequestAsync(requestId, tenantId, usuarioId, aliadoId, motivo, detalle) : Task<bool>
    + HasRejectedAsync(requestId, tenantId, usuarioId, aliadoId) : Task<bool>
    + GetRejectedRequestIdsAsync(tenantId, usuarioId, aliadoId) : Task
    + GetRejectedAllyIdsAsync(requestId, tenantId, usuarioId, role) : Task
  }
  interface IAllyRepository {
    + GetEligibleAlliesAsync(MatchCriteria) : Task
    + GetSolicitudContextAsync(requestId, tenantId) : Task<SolicitudContext>
    + GetAllyProfileAsync(usuarioId, tenantId) : Task<AllyProfile>
  }
  interface ICoreAssignmentClient {
    + AssignAsync(requestId, tenantId, idempotencyKey, correlationId) : Task<AssignmentResult>
    + GetOwnOffersAsync(tenantId, correlationId) : Task
  }
  class AssignmentResult <<record>> {
    + AssignmentStatus Status
    + Guid? AssignedAllyId
    + string? Message
    + string? Code
  }
  enum AssignmentStatus {
    Assigned
    AlreadyAssigned
    Conflict
    NotFound
    InvalidState
    Forbidden
    RejectedBefore
  }
  class AllyProfile <<record>> {
    + Guid Id
    + Guid TenantId
    + Guid UsuarioId
    + string EstadoVerificacion
  }
}

package "Infrastructure" {
  class PostgresSolicitudAssignmentRepository {
    - string _connectionString
    .. rol mani_dispatch_svc, RLS ..
    Solo rechazos (solicitud_rechazo):
    no escribe solicitud
  }
  class CoreAllyClient {
    - HttpClient _httpClient
    + GetAllyProfileAsync(usuarioId, tenantId) : Task<AllyProfile>
  }
  class CoreAssignmentClient {
    - HttpClient _httpClient
    + AssignAsync(...) : Task<AssignmentResult>
    .. POST /solicitudes/{id}/asignacion ..
    Reenvía el JWT del aliado y la clave
    de idempotencia
  }
}

package "Domain" {
  class CoreServiceUnavailableException {
    + CoreServiceUnavailableException(message, inner)
  }
}

DispatchController --> AcceptDispatchOfferUseCase : invoca
AcceptDispatchOfferUseCase --> IAllyRepository : exige perfil VERIFICADO
AcceptDispatchOfferUseCase --> ISolicitudAssignmentRepository : ¿ya rechazó? (409R)
AcceptDispatchOfferUseCase --> ICoreAssignmentClient : comando de asignación
AcceptDispatchOfferUseCase ..> AssignmentResult : devuelve
ISolicitudAssignmentRepository <|.. PostgresSolicitudAssignmentRepository
IAllyRepository <|.. CoreAllyClient : HTTP a Core (ADR-0030),\nnunca SQL contra tablas ajenas
ICoreAssignmentClient <|.. CoreAssignmentClient : HTTP a Core (decisión 6A)
CoreAllyClient ..> AllyProfile : deserializa
CoreAllyClient ..> CoreServiceUnavailableException : 503 si Core no responde
CoreAssignmentClient ..> CoreServiceUnavailableException : 503 si Core no responde
CoreAssignmentClient ..> AssignmentResult : 200 / 403 / 404 / 409
AssignmentResult --> AssignmentStatus

note bottom of CoreAssignmentClient
  La exclusión concurrente la aplica Core: bloquea la fila de la
  solicitud (FOR UPDATE) y repite el predicado
  estado = 'PENDIENTE' AND aliado_id IS NULL en el UPDATE.
  La segunda aceptación recibe 409 y no depende del número
  de réplicas (RNF-05, ADR-0016, ADR-0035).
end note
@enduml
